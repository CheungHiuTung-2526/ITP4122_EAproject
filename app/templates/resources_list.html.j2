{% extends "base.html.j2" %}

{% block title %}Learning Resources - IVE LWL Academic Hub{% endblock %}

{% block content %}
<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Learning Resources</h2>
            <p class="text-muted mb-0">Share and access study materials uploaded to Google Cloud Storage.</p>
        </div>
        {% if current_user.is_authenticated %}
        <a href="{{ url_for('resources.create') }}" class="btn btn-purple">
            <i class="bi bi-upload me-2"></i> Upload Resource
        </a>
        {% endif %}
    </div>

    <!-- Category Filter -->
    <div class="mb-4">
        <form method="GET" class="d-flex gap-2">
            <select name="category" class="form-select w-auto" onchange="this.form.submit()">
                <option value="">All Categories</option>
                {% for cat in categories %}
                <option value="{{ cat.id }}" {{ 'selected' if selected_category == cat.id else '' }}>{{ cat.name }}</option>
                {% endfor %}
            </select>
            {% if selected_category %}
            <a href="{{ url_for('resources.list') }}" class="btn btn-outline-secondary">Clear</a>
            {% endif %}
        </form>
    </div>

    {% if resources %}
    <div class="row g-4">
        {% for resource in resources %}
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <a href="{{ url_for('resources.view', id=resource.id) }}" class="text-decoration-none">
                            {{ resource.title }}
                        </a>
                    </h5>
                    <p class="card-text text-muted small">{{ resource.description[:120] }}{% if resource.description|length > 120 %}...{% endif %}</p>
                    
                    <div class="mt-3">
                        <span class="badge bg-secondary">{{ resource.category.name if resource.category else 'Uncategorized' }}</span>
                        <span class="text-muted small ms-2">by {{ resource.uploader.username }}</span>
                    </div>
                </div>
                <div class="card-footer bg-white">
                    <small class="text-muted">
                        {{ resource.created_at.strftime('%Y-%m-%d') }}
                        {% if resource.file_url %}
                        • <a href="{{ resource.file_url }}" target="_blank" class="text-decoration-none">Download from Cloud Storage</a>
                        {% endif %}
                    </small>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <div class="alert alert-info">
        No resources found. Be the first to upload!
    </div>
    {% endif %}

</div>
{% endblock %}