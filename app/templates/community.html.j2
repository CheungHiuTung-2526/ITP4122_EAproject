{% extends "base.html.j2" %}

{% block title %}Community Discussions - IVE LWL Academic Hub{% endblock %}

{% block content %}
<div class="container my-5">

    <!-- Page Header -->
    <div class="mb-4">
        <h2 class="mb-2">Community Discussions</h2>
        <p class="text-muted mb-0">
            Peer-to-peer academic discussions for Cloud & Data Centre students. 
            This platform complements Moodle by enabling informal knowledge sharing and collaboration.
        </p>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4">
        {% if current_user.is_authenticated %}
        <a href="{{ url_for('community.create_post') }}" class="btn btn-purple">
            <i class="bi bi-plus-lg me-2"></i> New Discussion
        </a>
        {% else %}
        <div></div>
        {% endif %}
    </div>

    <!-- Search + Category Filter -->
    <div class="row mb-4 g-3 align-items-end">
        <!-- Search Box -->
        <div class="col-lg-5 col-md-6">
            <form method="GET" class="d-flex">
                <input type="text" name="q" 
                       class="form-control" 
                       placeholder="Search discussions..." 
                       value="{{ query or '' }}">
                <button type="submit" class="btn btn-purple ms-2">
                    <i class="bi bi-search"></i>
                </button>
            </form>
        </div>

        <!-- Category Filter -->
        <div class="col-lg-3 col-md-3">
            <form method="GET">
                <select name="category" class="form-select" onchange="this.form.submit()">
                    <option value="">All Categories</option>
                    <option value="general" {{ 'selected' if category == 'general' else '' }}>General</option>
                    <option value="help" {{ 'selected' if category == 'help' else '' }}>Help & Questions</option>
                    <option value="showcase" {{ 'selected' if category == 'showcase' else '' }}>Showcase</option>
                    <option value="cloud" {{ 'selected' if category == 'cloud' else '' }}>Cloud & DevOps</option>
                </select>
            </form>
        </div>

        <!-- Clear Filters -->
        {% if query or category %}
        <div class="col-lg-2 col-md-3">
            <a href="{{ url_for('community.index', sort=sort) }}" 
               class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle"></i> Clear Filters
            </a>
        </div>
        {% endif %}
    </div>

    <!-- Sorting Tabs -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link {% if not sort or sort == 'latest' %}active{% endif %}" 
               href="{{ url_for('community.index', sort='latest', q=query, category=category) }}">Latest</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if sort == 'popular' %}active{% endif %}" 
               href="{{ url_for('community.index', sort='popular', q=query, category=category) }}">Most Discussed</a>
        </li>
        <li class="nav-item">
            <a class="nav-link {% if sort == 'pinned' %}active{% endif %}" 
               href="{{ url_for('community.index', sort='pinned', q=query, category=category) }}">Pinned</a>
        </li>
    </ul>

    <!-- Discussion Posts List -->
    {% if posts %}
        {% for post in posts %}
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h5 class="card-title mb-1">
                            <a href="{{ url_for('community.view_post', id=post.id) }}" class="text-decoration-none">
                                {{ post.title }}
                            </a>
                            {% if post.is_pinned %}
                                <span class="badge bg-warning text-dark ms-2">Pinned</span>
                            {% endif %}
                        </h5>
                        <p class="text-muted small mb-2">
                            by <strong>{{ post.author.username }}</strong> 
                            • {{ post.created_at.strftime('%Y-%m-%d %H:%M') }}
                            {% if post.category %}
                                • <span class="badge bg-secondary">{{ post.category }}</span>
                            {% endif %}
                        </p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-dark">{{ post.comments.count() }} comments</span>
                    </div>
                </div>
                <p class="card-text text-muted">{{ post.content[:200] }}{% if post.content|length > 200 %}...{% endif %}</p>
            </div>
        </div>
        {% endfor %}
    {% else %}
        <div class="alert alert-info">
            No discussions found. Be the first to start a conversation!
        </div>
    {% endif %}

    <!-- Pagination -->
    {% if pagination and pagination.pages > 1 %}
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            {% for page_num in pagination.iter_pages() %}
                {% if page_num %}
                    {% if page_num != pagination.page %}
                    <li class="page-item">
                        <a class="page-link" href="{{ url_for('community.index', page=page_num, sort=sort, q=query, category=category) }}">{{ page_num }}</a>
                    </li>
                    {% else %}
                    <li class="page-item active"><span class="page-link">{{ page_num }}</span></li>
                    {% endif %}
                {% else %}
                    <li class="page-item disabled"><span class="page-link">...</span></li>
                {% endif %}
            {% endfor %}
        </ul>
    </nav>
    {% endif %}

</div>
{% endblock %}